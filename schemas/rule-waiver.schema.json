{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-factory.local/schemas/rule-waiver.schema.json",
  "title": "Context Factory Governed Rule Waiver Contract",
  "type": "object",
  "required": [
    "id",
    "directiveId",
    "scope",
    "authorizedBy",
    "authorizedAt",
    "rationale",
    "compensatingEvidence",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "directiveId": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authorizedBy": {
      "type": "string",
      "minLength": 1
    },
    "authorizedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "compensatingEvidence": {
      "type": "string",
      "minLength": 1
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewTrigger": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "revoked"
      ]
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-factory.local/schemas/conformance-result.schema.json",
  "title": "Context Factory Conformance Result Contract",
  "type": "object",
  "required": [
    "directiveId",
    "status",
    "mode",
    "evidence",
    "evaluatedAt"
  ],
  "properties": {
    "directiveId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "WAIVED",
        "NOT_AUTOMATABLE",
        "TOOL_UNAVAILABLE",
        "UNSUPPORTED"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "automated-blocking",
        "evidence-blocking",
        "advisory",
        "unsupported"
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["verifierType"],
      "properties": {
        "verifierType": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string"
        },
        "exitCode": {
          "type": "integer"
        },
        "outputFragment": {
          "type": "string"
        },
        "humanEvidence": {
          "type": "string"
        },
        "waiverId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}

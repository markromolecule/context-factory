{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-factory.local/schemas/run-result.schema.json",
  "title": "Context Factory Run Result",
  "type": "object",
  "required": [
    "runId",
    "status",
    "provider",
    "model",
    "prompt",
    "output",
    "createdAt"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "error",
        "rejected"
      ]
    },
    "provider": {
      "type": "string",
      "enum": [
        "openai",
        "anthropic",
        "gemini",
        "mock",
        "custom"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string"
    },
    "output": {
      "description": "Structured or raw text output produced by runner"
    },
    "tokens": {
      "type": "object",
      "properties": {
        "promptTokens": {
          "type": "integer",
          "minimum": 0
        },
        "completionTokens": {
          "type": "integer",
          "minimum": 0
        },
        "totalTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "hooksExecuted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "toolCalls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "arguments": {
            "type": "object"
          },
          "result": {}
        },
        "additionalProperties": true
      }
    },
    "validationErrors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
